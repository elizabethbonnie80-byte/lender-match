# Next.js app environment — copy to `.env.local` and fill in.
#
# `.env.local` is gitignored and is NOT in the repo — a fresh clone has to create it, or the app fails
# with an error that never names the missing file. For LOCAL development copy this file to `.env.local`
# and paste the anon key that `pnpm db:start` prints (re-print it any time with `pnpm exec supabase
# status`): the well-known Supabase local defaults, public dev keys, NOT secrets. For a hosted
# deployment, set these in the deployment environment (Vercel/CI), never in a committed file, and use
# that project's own URL + anon key.

# Supabase project API URL (local default shown).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/publishable key — safe to expose to the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# NOTE: never put the service-role key here — it is server-side only (edge functions / tooling).
